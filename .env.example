# MongoDB Atlas connection string.
# Keep real credentials only in .env, never in this file.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=<app-name>
MONGODB_DB=policies
MONGODB_COLLECTION=policy_chunks

# Voyage AI / MongoDB Atlas Embedding and Reranking API.
VOYAGE_API_KEY=<your-voyage-or-atlas-model-api-key>
VOYAGE_API_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-3-large
VOYAGE_INPUT_TYPE=document
