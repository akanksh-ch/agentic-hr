# MongoDB Atlas connection string.
# Keep real credentials only in .env, never in this file.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=<app-name>
MONGODB_DB=policies
MONGODB_COLLECTION=policy_chunks
MONGODB_ONBOARDING_COLLECTION=onboarding_sessions
MONGODB_VECTOR_INDEX=policy_vector_index

# Voyage AI / MongoDB Atlas Embedding and Reranking API.
VOYAGE_API_KEY=<your-voyage-or-atlas-model-api-key>
VOYAGE_API_BASE_URL=https://ai.mongodb.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-3-large
VOYAGE_INPUT_TYPE=document

# LiveKit testing agent.
# Keep real keys only in .env.
LIVEKIT_URL=wss://<your-livekit-project>.livekit.cloud
LIVEKIT_API_KEY=<your-livekit-api-key>
LIVEKIT_API_SECRET=<your-livekit-api-secret>
LIVEKIT_AGENT_NAME=agentic-hr
LIVEKIT_QUERY_LLM_MODEL=google/gemini-2.5-flash
